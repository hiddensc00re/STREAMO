generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StreamType {
  live_camera
  file
}

model Stream {
  id             String     @id @default(cuid())
  title          String
  streamerName   String     @map("streamer_name")
  streamType     StreamType @map("stream_type")
  hasVideo       Boolean    @map("has_video")
  hasAudio       Boolean    @map("has_audio")
  isLive         Boolean    @default(false) @map("is_live")
  viewerCount    Int        @default(0) @map("viewer_count")
  scheduledAt    DateTime?  @map("scheduled_at")
  ownerTokenHash String     @map("owner_token_hash")
  endedAt        DateTime?  @map("ended_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  fileBroadcast  FileBroadcast?

  @@index([isLive, createdAt])
  @@index([scheduledAt])
  @@map("streams")
}

model FileBroadcast {
  streamId    String   @id @map("stream_id")
  stream      Stream   @relation(fields: [streamId], references: [id], onDelete: Cascade)
  path        String   @unique
  name        String
  mime        String
  size        Int
  duration    Float    @default(0)
  status      String   @default("uploading")
  position    Float    @default(0)
  anchor      DateTime @default(now())
  uploadUntil DateTime @map("upload_until")

  @@map("file_broadcasts")
}
