DATABASE_URL="postgresql://streamo:streamo@localhost:5432/streamo"
NEXT_PUBLIC_SIGNALING_URL="http://localhost:4001"
SIGNALING_PUBLIC_URL="http://localhost:4001"
SIGNALING_PORT=4001
# Optional TURN for NAT traversal in production (host:port)
# NEXT_PUBLIC_TURN_URL="turn:turn.example.com:3478"
# NEXT_PUBLIC_TURN_USERNAME="user"
# NEXT_PUBLIC_TURN_CREDENTIAL="pass"
# Comma-separated origins allowed to connect to the signaling server
CORS_ORIGINS="http://localhost:3000"
# Shared secret so the signaling server can update viewer counts
INTERNAL_API_SECRET="change-me-in-production"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server-only credentials for private uploaded file events (never NEXT_PUBLIC_).
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SECRET_KEY=""
