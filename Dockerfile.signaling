# syntax=docker/dockerfile:1
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm install tsx
COPY src/lib/rate-limit.ts ./src/lib/rate-limit.ts
COPY server ./server
EXPOSE 4001
ENV PORT=4001
CMD ["npx", "tsx", "server/index.ts"]
